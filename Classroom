function exportClass(){var data={class:state.activeClass,members:state.members,posts:state.posts,comments:state.comments,submissions:state.submissions,topics:state.topics,exportedAt:new Date().toISOString()};var blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=(state.activeClass.title||'class')+'.json';a.click();URL.revokeObjectURL(a.href)}

init();
})();

